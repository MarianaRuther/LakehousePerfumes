{
  "datasets": [
    {
      "name": "ds_fato_vendas",
      "displayName": "Fato de vendas",
      "queryLines": [
        "SELECT data_pedido, ano, mes, canal, cliente_id, razao_social, segmento, cidade, marca, categoria, quantidade, preco_praticado, receita, custo, margem, devolucao, pedido_id \n",
        "FROM fato_vendas"
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Soma da receita do item. Negativa em devolução, então já reconcilia com a silver. Chamada 'Receita Total' (não 'Receita') porque SQL resolve identificadores sem diferenciar maiúsculas/minúsculas — um campo calculado chamado 'Receita' que soma a coluna bruta `receita` vira referência circular.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem Total",
          "description": "Soma da margem (receita menos custo do produto). Mesmo motivo do nome 'Margem Total': evitar colisão case-insensitive com a coluna bruta `margem`.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Número de pedidos distintos.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio",
          "description": "Receita total dividida pelo número de pedidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem sobre receita, de 0 a 1.",
          "expression": "SUM(`margem`) / SUM(`receita`)"
        }
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes por receita",
      "queryLines": [
        "SELECT cliente_id, razao_social, segmento, cidade, SUM(receita) AS receita \n",
        "FROM fato_vendas \n",
        "GROUP BY cliente_id, razao_social, segmento, cidade \n",
        "ORDER BY receita DESC \n",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_fila_semanal",
      "displayName": "Fila semanal de ligação",
      "queryLines": [
        "SELECT vendedor, ordem, cliente_id, razao_social, cidade, uf, score, faixa, ticket_medio, motivo, sugestao \n",
        "FROM fila_semanal \n",
        "ORDER BY vendedor, ordem"
      ]
    }
  ],
